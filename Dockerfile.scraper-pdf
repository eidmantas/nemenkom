FROM python:3.13-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt requirements-pdf.txt .
RUN pip install --no-cache-dir -r requirements.txt

# `marker-pdf` still pins `openai<2` and `anthropic<0.47`. We install the
# pinned PDF stack separately, then explicitly force-upgrade the SDKs used by
# our AI provider code.
RUN pip install --no-cache-dir -r requirements-pdf.txt \
  && pip install --no-cache-dir --no-deps openai==2.16.0 anthropic==0.77.1

# Needed code
COPY services/scraper_pdf services/scraper_pdf
COPY services/scraper services/scraper
COPY services/calendar/migrations services/calendar/migrations
COPY services/common services/common

ENV PYTHONPATH=/app

CMD ["python", "services/scraper_pdf/scheduler.py"]
